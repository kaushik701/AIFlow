step Translate {
    model: "gpt-4";
    prompt: "Translate the following English text to Spanish: {{text}}";
    output: spanish;
}

step Verify {
    model: "gpt-4";
    prompt: "Verify this Spanish translation for accuracy and natural phrasing. If there are any issues, provide the corrected version: {{spanish}}";
    output: verified;
}

return: verified;